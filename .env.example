# ==========================================================================
# EDUCIA CÔTE D'IVOIRE — variables d'environnement
# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Ne jamais committer le fichier ".env" réel (déjà exclu par .gitignore).
# ==========================================================================

# --- Base de données PostgreSQL ---
# Exemple avec Neon, Supabase ou une instance PostgreSQL classique.
DATABASE_URL="postgresql://user:password@localhost:5432/educia?schema=public"

# --- Authentification ---
# Clé secrète utilisée pour signer les JWT de session. Générez une valeur
# aléatoire forte, ex: `openssl rand -base64 32`.
JWT_SECRET="remplacez-moi-par-une-valeur-aleatoire-forte"
JWT_EXPIRES_IN="30d"

# --- Intelligence Artificielle (Anthropic Claude) ---
# Utilisé pour : le tuteur IA, l'OCR/vision de documents, la génération
# d'exercices et d'examens, la correction automatique.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Recherche web autonome (agent de recherche) ---
# Clé optionnelle pour une API de recherche (ex: Brave Search, Bing Search).
# Si absente, l'agent de recherche web reste désactivé et se limite à la
# base de connaissances interne (comportement conforme aux règles de
# recherche : interne avant externe).
WEB_SEARCH_API_KEY=""
WEB_SEARCH_PROVIDER="brave"

# --- Notifications WhatsApp (API Business WhatsApp / Twilio / Meta Cloud API) ---
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Notifications Email (rapports parents) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="EDUCIA Côte d'Ivoire <no-reply@educia.ci>"

# --- Stockage des fichiers importés (documents, photos, audio, vidéo) ---
# "local" pour le développement, "s3" pour la production (ex: AWS S3,
# Cloudflare R2, Supabase Storage compatible S3).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EDUCIA Côte d'Ivoire"
NODE_ENV="development"
